eval "$(devbox generate direnv --print-envrc)"

# ──────────────────────────────────────────────────────────────────────────
# MemeForge — workshop dev environment
#
# Questo file È committato nel repo (vedi .gitignore: `!.envrc`).
# Condiviso con tutti gli attendees del workshop AI Builder: chi clona
# il repo ottiene un ambiente già pronto (Pexels live + JWT firmato).
# Per chiavi personali (es. Stripe sandbox), crea `.envrc.local` — quello
# resta sempre gitignored.
# ──────────────────────────────────────────────────────────────────────────

# NODE_ENV è gestito da Next.js stesso (dev/build/start lo settano).
# Non esportarlo qui — fa rompere `pnpm build` (prerender error).

# Pexels — ricerca immagini + video in tempo reale.
# Chiave condivisa per il workshop, rate-limited dal piano gratuito.
# In produzione genera la tua: https://www.pexels.com/api/
export PEXELS_API_KEY="kHiBWapHK8xrnoYUQCdcbiyuaWn21xRfsVNuLfAYTrkpu02iHCPkM8YE"

# Segreto JWT per firmare i token di sblocco HD.
# In locale qualsiasi stringa va bene. In produzione genera con:
#   openssl rand -base64 32
export UNLOCK_SECRET="memeforge-workshop-local-secret-change-me-in-prod"

# URL pubblico dell'app — usato dai redirect Stripe Checkout.
# Vercel sovrascrive automaticamente con VERCEL_URL in produzione.
export NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────────────────────────
# Stripe (opzionale) — la modalità locale permette di scaricare l'HD
# senza pagamento. Per testare il flusso Stripe sandbox, crea un file
# `.envrc.local` (non versionato) con:
#
#   export STRIPE_SECRET_KEY="sk_test_..."
#   export NEXT_PUBLIC_STRIPE_ENABLED="1"
# ──────────────────────────────────────────────────────────────────────────

if [ -f .envrc.local ]; then
  source .envrc.local
fi
