# ──────────────────────────────────────────────────────────────────────────
# MemeForge monorepo — root .gitignore
#
# Each subproject (meme-studio, meme-studio-starter) has its own .gitignore
# with workshop-specific env rules (whitelists .envrc + .env.development).
# Those rules compose with this file. Keep this one generic.
# ──────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# ── Build output ──────────────────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Testing / coverage ────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Env files ─────────────────────────────────────────────────────────────
# Each subproject .gitignore handles its own whitelist for committed
# workshop defaults (.envrc, .env.development). At the root we just ignore
# anything that looks like a stray personal env file.
.env
.env.local
.env.*.local
.envrc.local

# ── Devbox ────────────────────────────────────────────────────────────────
# devbox.json + devbox.lock ARE committed inside each subproject.
# .devbox/ is the local cache, never committed.
.devbox/

# ── Vercel ────────────────────────────────────────────────────────────────
.vercel/

# ── Editor / IDE ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── Cursor ────────────────────────────────────────────────────────────────
.cursor/
.cursorignore

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ── Misc ──────────────────────────────────────────────────────────────────
*.pem
.tmp/
.cache/
.turbo/
