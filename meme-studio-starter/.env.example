# ──────────────────────────────────────────────────────────────────────────
# MemeForge Starter — environment variables
# ──────────────────────────────────────────────────────────────────────────
# In locale NON serve creare un `.env`: `direnv` carica i valori dal
# file `.envrc` (committato, con defaults condivisi del workshop).
#
# Questo file è solo documentazione: ti dice cosa configurare quando
# deploi su Vercel o quando vuoi sovrascrivere localmente le chiavi
# (in quel caso usa `.envrc.local`, non versionato).
# ──────────────────────────────────────────────────────────────────────────

# Pexels — ricerca immagini e video in tempo reale (.envrc include una
# chiave condivisa per il workshop). Genera la tua per la produzione:
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Segreto per firmare i JWT di sblocco HD. In locale qualsiasi stringa
# va bene; in produzione genera con: openssl rand -base64 32
UNLOCK_SECRET=

# Stripe (opzionale) — sblocco HD a pagamento. Senza chiave la
# modalità locale permette di scaricare l'HD gratis. Per testare:
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Imposta a "1" per attivare il flusso Stripe in UI (anche in dev).
NEXT_PUBLIC_STRIPE_ENABLED=

# URL pubblico dell'app — usato per i redirect Stripe Checkout.
# Default in dev: http://localhost:3000. Su Vercel VERCEL_URL viene
# usato automaticamente.
NEXT_PUBLIC_APP_URL=
